<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Grocery.App.ViewModels"
             x:Class="Grocery.App.Views.NewProductView"
             x:DataType="vm:NewProductViewModel"
             Title="Nieuw Product">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Productnaam" FontAttributes="Bold"/>
            <Entry Text="{Binding Name}" 
                   Placeholder="Voer productnaam in"
                   IsEnabled="{Binding IsAdmin}"/>
            <Label Text="Voorraad" FontAttributes="Bold"/>
            <Entry Text="{Binding Stock}" 
                   Keyboard="Numeric"
                   Placeholder="Voer voorraad in"
                   IsEnabled="{Binding IsAdmin}"/>
            <Label Text="Prijs (euro)" FontAttributes="Bold"/>
            <Entry Text="{Binding Price}" 
                   Keyboard="Numeric"
                   Placeholder="Voer prijs in"
                   IsEnabled="{Binding IsAdmin}"/>
            <Label Text="Houdbaarheidsdatum" FontAttributes="Bold"/>
            <DatePicker Date="{Binding ShelfLifeDate}"
                        Format="dd-MM-yyyy"
                        IsEnabled="{Binding IsAdmin}"/>
            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Text="Annuleren" 
                        Command="{Binding CancelCommand}"
                        Grid.Column="0"
                        BackgroundColor="Gray"/>
                <Button Text="Opslaan" 
                        Command="{Binding SaveProductCommand}"
                        Grid.Column="1"
                        IsEnabled="{Binding IsAdmin}"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>